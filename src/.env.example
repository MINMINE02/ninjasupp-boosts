# SellAuth dynamic delivery (or paste it later in Admin panel -> SellAuth)
SELLAUTH_WEBHOOK_SECRET=

# Optional
BOOSTS_PER_TOKEN=2
CAPTCHA_COST=0.015
LOGO_URL=
MAINTENANCE_MODE=
TATUM_API_KEY=
