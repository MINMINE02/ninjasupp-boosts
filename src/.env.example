# Copy to .env and fill in. Full explanations: docs/ENVIRONMENT.md
PORT=3000
NODE_ENV=production

JWT_SECRET=change-me-to-a-long-random-string
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SALTA7_MASTER_TOKEN=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
